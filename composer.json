{
    "name": "nurbekjummayev/laravel-tdc-sso-client",
    "description": "TDC-SSO (OAuth2 Authorization Code + PKCE) BFF authentication for Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "sso",
        "oauth2",
        "pkce",
        "passport",
        "tdc"
    ],
    "authors": [
        {
            "name": "Nurbek Jummayev",
            "email": "jummayevnurbek279@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "laravel/passport": "^12.0|^13.0",
        "nurbekjummayev/laravel-api-response-helpers": "^1.1",
        "spatie/laravel-package-tools": "^1.92.7",
        "spatie/laravel-permission": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Nurbekjummayev\\LaravelTdcSsoClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nurbekjummayev\\LaravelTdcSsoClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nurbekjummayev\\LaravelTdcSsoClient\\Providers\\SsoServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "format": "vendor/bin/pint"
    },
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
